# =============================================================================
# Food Request — environment template (Vercel + local)
# Copy to `.env` for local dev. Set the same keys in Vercel → Environment Variables.
# Do NOT commit `.env`. Replace YOUR_* placeholders with real secrets.
# Enable each variable for: Production, Preview, Development — then Redeploy.
# =============================================================================

# --- MongoDB Atlas (required) — database name must be food_requester ---
# User: sankardev2001_db_user | Cluster: cluster0.gsc0ez6
# If password contains @ use %40 (e.g. pass@word → pass%40word)
MONGODB_URI=mongodb+srv://sankardev2001_db_user:DlGRdWjsvRcL4aPR@cluster0.gsc0ez6.mongodb.net/food_requester?retryWrites=true&w=majority&appName=Cluster0

# --- Auth (required on Vercel) — min 32 chars: openssl rand -base64 32 ---
JWT_SECRET=secret123

# --- App URL (recommended on Vercel) — no trailing slash ---
APP_URL=https://food-request.vercel.app

# --- Gemini (optional) ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# --- Admin (optional legacy; login uses MongoDB users) ---
ADMIN_PASSCODE=admin123

# --- Firebase client (required at Vite build time) — project: food-308fc ---
VITE_FIREBASE_API_KEY=AIzaSyCVhH2fBv5_n1pl8WujaIrJciP1ufOhcR0
VITE_FIREBASE_AUTH_DOMAIN=food-308fc.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://food-308fc-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=food-308fc
VITE_FIREBASE_STORAGE_BUCKET=food-308fc.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=575899266033
VITE_FIREBASE_APP_ID=1:575899266033:web:a19b06033425373dfbf250

# --- Firebase Admin (required for server push notifications) ---
# Paste minified one-line JSON from Firebase → Project settings → Service accounts → Generate key
FIREBASE_SERVICE_ACCOUNT=YOUR_FIREBASE_SERVICE_ACCOUNT_JSON_ONE_LINE
